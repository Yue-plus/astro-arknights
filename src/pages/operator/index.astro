---
import {getCollection} from 'astro:content'
import InfoLayout from "../../layouts/InfoLayout.astro"
import GoBackTool from "../../components/GoBackTool"

const base = import.meta.env.BASE_URL
const allOperator = await getCollection("operator");

// 提取唯一的 ID
const uniqueIds = [...new Set(allOperator.map(item => item.data.id))];
---

<InfoLayout title="OPERATOR" subTitle="人物信息" tabTitle="人物">
    <div id="operator-container" class="h-full flex-auto mr-[-16px] overflow-x-hidden overflow-y-scroll">
        <div id="operator-scroll-wrapper">
            <nav id="operator-content" class="max-w-[80.75rem] mx-auto pt-4 pb-8">
                {allOperator.length > 0 ? (
                    allOperator.map((item, index) => (
                        <div class="operator-item w-full" data-id={item.data.id}>
                            <a target="_blank" href={`${base}operator/${item.slug}`} title={item.data.title ?? item.data.id}
                               class="group relative flex items-center w-full max-w-[64rem] mx-auto gap-8 px-2 py-7 border-b border-white/15 hover:bg-white/5 transition-colors duration-300 no-underline text-inherit cursor-pointer">
                                <div class="shrink-0 w-24 h-24 flex flex-col items-center justify-center border border-white/20 group-hover:border-ark-blue transition-colors duration-300">
                                    <div class="text-ark-blue font-oswaldMedium text-3xl leading-none">{String(index + 1).padStart(2, "0")}</div>
                                    <div class="mt-2 font-benderBold text-[0.625rem] tracking-[0.25em] text-white/40">OPERATOR</div>
                                </div>

                                <div class="shrink-0 flex flex-col justify-center">
                                    <div class="text-ark-blue text-lg font-bold whitespace-nowrap">{item.data.id ?? "未知"}</div>
                                    <div class="mt-2 font-benderBold text-[0.6875rem] tracking-[0.25em] text-white/40">PROFILE</div>
                                </div>

                                <div class="flex-1 min-w-0 pl-8 border-l border-white/10">
                                    <div class="font-benderRegular text-sm tracking-[0.15em] text-white/50">CHARACTER RECORD</div>
                                    <div class="mt-1.5 text-white text-2xl font-bold leading-snug truncate group-hover:text-ark-blue transition-colors duration-300">{item.data.title ?? item.data.id}</div>
                                </div>

                                <svg class="shrink-0 w-6 h-6 text-ark-blue opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                            </a>
                        </div>
                    ))
                ) : (
                    <div class="text-center text-2xl font-n15eBold pt-12 pb-16">无人物数据</div>
                )}
            </nav>
            <div class="text-center text-sm tracking-[0.4em] text-white/40 font-benderBold pt-8 pb-8">- END -</div>
        </div>
    </div>

    <GoBackTool slot="tool-panel" client:load/>

    <div slot="aside-header">
        <div class="pr-4">
            <div class="flex items-center gap-3 pb-5 border-b border-white/15">
                <span class="h-9 w-1 bg-ark-blue"></span>
                <div>
                    <div class="text-white text-lg font-benderBold leading-none tracking-[0.2em]">FILTER</div>
                    <div class="text-white/50 text-sm mt-1.5">人物筛选</div>
                </div>
            </div>
            <div class="flex flex-col gap-2.5 mt-6">
                <button class="id-btn active w-full flex items-center justify-between px-5 py-3 bg-ark-blue transition-colors duration-300 cursor-pointer font-bold" data-id="all">
                    <span>全部</span>
                    <span class="font-benderBold text-sm opacity-70">ALL</span>
                </button>
                {uniqueIds.map((id) => (
                    <button class="id-btn w-full flex items-center justify-between px-5 py-3 bg-[#5a5a5a] transition-colors duration-300 cursor-pointer font-bold" data-id={id}>
                        <span>{id}</span>
                        <span class="font-benderBold text-sm opacity-70">OPTR</span>
                    </button>
                ))}
            </div>
        </div>
    </div>
</InfoLayout>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        // 筛选功能
        const idBtns = document.querySelectorAll('.id-btn');
        const operatorItems = document.querySelectorAll('.operator-item');
        
        // 从 URL 获取筛选参数
        function getSelectedIdFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('id') || 'all';
        }
        
        // 更新 URL 中的筛选参数
        function updateUrl(selectedId) {
            const url = new URL(window.location.href);
            if (selectedId === 'all') {
                url.searchParams.delete('id');
            } else {
                url.searchParams.set('id', selectedId);
            }
            window.history.pushState({}, '', url);
        }
        
        // 执行筛选操作
        function performFilter(selectedId) {
            // 移除所有按钮的 active 类
            idBtns.forEach(b => {
                b.classList.remove('active', 'bg-ark-blue');
                b.classList.add('bg-[#5a5a5a]');
            });
            
            // 添加当前按钮的 active 类
            const activeBtn = document.querySelector(`.id-btn[data-id="${selectedId}"]`);
            if (activeBtn) {
                activeBtn.classList.add('active', 'bg-ark-blue');
                activeBtn.classList.remove('bg-[#5a5a5a]');
            }
            
            // 筛选人物
            operatorItems.forEach(item => {
                if (selectedId === 'all' || item.dataset.id === selectedId) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
        
        // 初始化页面时，根据 URL 参数执行筛选
        const initialId = getSelectedIdFromUrl();
        performFilter(initialId);
        
        // 为筛选按钮添加点击事件
        idBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const selectedId = this.dataset.id;
                updateUrl(selectedId);
                performFilter(selectedId);
            });
        });
    });
</script>

<style>
  .id-btn { color: #fff; }
  .id-btn:not(.active):hover { background-color: #6b6b6b; }
  .id-btn.active { color: #000; }
</style>