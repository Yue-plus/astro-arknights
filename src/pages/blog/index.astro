---
import {getCollection} from 'astro:content'
import InfoLayout from "../../layouts/InfoLayout.astro"
import GoBackTool from "../../components/GoBackTool"

const base = import.meta.env.BASE_URL
const allBlog = await getCollection("blog");

// 辅助函数：获取缩略图路径
function getThumbnailPath(category: string | undefined, thumbnail: string | undefined): string {
    const categoryToThumbnail: Record<string, string> = {
        "微故事": "ACTIVITY.jpg",
        "事件": "NEWS.jpg",
        "世界观": "ANNOUNCEMENT.jpg"
    };
    return thumbnail ?? categoryToThumbnail[category as keyof typeof categoryToThumbnail] ?? "ACTIVITY.jpg";
}

// 辅助函数：从内容 id（如 "2025-11-17_标题"）解析日期
function getDateParts(id: string): { year: string, month: string, day: string } | null {
    const match = id.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
    return match ? { year: match[1], month: match[2], day: match[3] } : null;
}
---

<InfoLayout title="Universe" subTitle="宇宙" tabTitle="宇宙">
    <div id="blog-container" class="h-full flex-auto mr-[-16px] overflow-x-hidden overflow-y-scroll">
        <div id="blog-scroll-wrapper">
            <nav id="blog-content" class="max-w-[80.75rem] mx-auto">
                {
                    (allBlog.length > 0) && allBlog.map((item) => {
                        const category = item.data.category ?? '未分类';
                        const title = item.data.title ?? item.id;
                        const date = getDateParts(item.id);
                        const year = date?.year ?? "----";
                        const month = date?.month ?? "--";
                        const day = date?.day ?? "--";
                        const thumbnail = `${base}info-thumbnail/${getThumbnailPath(item.data.category, item.data.thumbnail)}`;
                        return (
                            <div class="blog-item w-full flex justify-center" data-category={category}>
                                <a target="_blank" href={`${base}blog/${item.slug}`} title={title}
                                   class="group relative flex items-center w-full max-w-[64rem] gap-8 px-2 py-7 border-b border-white/15 hover:bg-white/5 transition-colors duration-300 no-underline text-inherit cursor-pointer">
                                    <div class="shrink-0 w-44 h-28 overflow-hidden">
                                        <img class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition duration-500"
                                             src={thumbnail}
                                             alt={`${title} - 缩略图`}/>
                                    </div>

                                    <div class="shrink-0 flex flex-col justify-center">
                                        <div class="text-ark-blue text-lg font-bold whitespace-nowrap">{category}</div>
                                        <div class="mt-2 font-benderBold text-[0.6875rem] tracking-[0.25em] text-white/40">ARCHIVE</div>
                                    </div>

                                    <div class="flex-1 min-w-0 ml-6 pl-8 border-l border-white/10">
                                        <div class="font-benderRegular text-sm tracking-[0.15em] text-white/50">{year} // {month} / {day}</div>
                                        <div class="mt-1.5 text-white text-2xl font-bold leading-snug truncate group-hover:text-ark-blue transition-colors duration-300">{title}</div>
                                    </div>

                                    <svg class="shrink-0 w-6 h-6 text-ark-blue opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                                </a>
                            </div>
                        );
                    })
                }
            </nav>
            <div class="text-center text-sm tracking-[0.4em] text-white/40 font-benderBold pt-8 pb-8">- END -</div>
        </div>
    </div>

    <div slot="aside-header">
        <div class="pr-4">
            <div class="flex items-center gap-3 pb-5 border-b border-white/15">
                <span class="h-9 w-1 bg-ark-blue"></span>
                <div>
                    <div class="text-white text-lg font-benderBold leading-none tracking-[0.2em]">FILTER</div>
                    <div class="text-white/50 text-sm mt-1.5">分类筛选</div>
                </div>
            </div>
            <div class="flex flex-col gap-2.5 mt-6">
                <button class="category-btn active w-full flex items-center justify-between px-5 py-3 bg-ark-blue transition-colors duration-300 cursor-pointer font-bold" data-category="all">
                    <span>全部</span>
                    <span class="font-benderBold text-sm opacity-70">ALL</span>
                </button>
                <button class="category-btn w-full flex items-center justify-between px-5 py-3 bg-[#5a5a5a] transition-colors duration-300 cursor-pointer font-bold" data-category="微故事">
                    <span>微故事</span>
                    <span class="font-benderBold text-sm opacity-70">STORY</span>
                </button>
                <button class="category-btn w-full flex items-center justify-between px-5 py-3 bg-[#5a5a5a] transition-colors duration-300 cursor-pointer font-bold" data-category="事件">
                    <span>事件</span>
                    <span class="font-benderBold text-sm opacity-70">EVENT</span>
                </button>
                <button class="category-btn w-full flex items-center justify-between px-5 py-3 bg-[#5a5a5a] transition-colors duration-300 cursor-pointer font-bold" data-category="世界观">
                    <span>世界观</span>
                    <span class="font-benderBold text-sm opacity-70">WORLD</span>
                </button>
            </div>
        </div>
    </div>

    <GoBackTool slot="tool-panel" client:load/>
</InfoLayout>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const container = document.getElementById('blog-container');
        const wrapper = document.getElementById('blog-scroll-wrapper');
        
        if (container && wrapper) {
            // 复制整个内容包装器以实现循环滚动
            const wrapperClone = wrapper.cloneNode(true);
            wrapperClone.id = 'blog-scroll-wrapper-clone';
            wrapper.parentNode.insertBefore(wrapperClone, wrapper.nextSibling);
            
            let isScrolling = true;
            const scrollSpeed = 0.8; // 滚动速度，值越小越慢
            
            // 当用户交互时暂停滚动
            container.addEventListener('mouseenter', function() {
                isScrolling = false;
            });
            
            container.addEventListener('mouseleave', function() {
                isScrolling = true;
            });
            
            container.addEventListener('touchstart', function() {
                isScrolling = false;
            });
            
            container.addEventListener('touchend', function() {
                isScrolling = true;
            });
            
            // 自动滚动函数
            function autoScroll() {
                if (isScrolling) {
                    container.scrollTop += scrollSpeed;
                    
                    // 当滚动到原始内容的末尾时，无缝重置到复制内容的开头
                    const wrapperHeight = wrapper.offsetHeight;
                    if (container.scrollTop >= wrapperHeight) {
                        container.scrollTop = 0;
                    }
                }
                requestAnimationFrame(autoScroll);
            }
            
            // 开始自动滚动
            autoScroll();
        }
        
        // 筛选功能
        const categoryBtns = document.querySelectorAll('.category-btn');
        const blogItems = document.querySelectorAll('.blog-item');
        
        // 从 URL 获取筛选参数
        function getSelectedCategoryFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('category') || 'all';
        }
        
        // 更新 URL 中的筛选参数
        function updateUrl(selectedCategory) {
            const url = new URL(window.location.href);
            if (selectedCategory === 'all') {
                url.searchParams.delete('category');
            } else {
                url.searchParams.set('category', selectedCategory);
            }
            window.history.pushState({}, '', url);
        }
        
        // 执行筛选操作
        function performFilter(selectedCategory) {
            // 移除所有按钮的 active 类
            categoryBtns.forEach(b => {
                b.classList.remove('active', 'bg-ark-blue');
                b.classList.add('bg-[#5a5a5a]');
            });
            
            // 添加当前按钮的 active 类
            const activeBtn = document.querySelector(`.category-btn[data-category="${selectedCategory}"]`);
            if (activeBtn) {
                activeBtn.classList.add('active', 'bg-ark-blue');
                activeBtn.classList.remove('bg-[#5a5a5a]');
            }
            
            // 筛选文章
            blogItems.forEach(item => {
                if (selectedCategory === 'all' || item.dataset.category === selectedCategory) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
            
            // 重置滚动位置
            const blogContainer = document.getElementById('blog-container');
            if (blogContainer) {
                blogContainer.scrollTop = 0;
            }
        }
        
        // 初始化页面时，根据 URL 参数执行筛选
        const initialCategory = getSelectedCategoryFromUrl();
        performFilter(initialCategory);
        
        // 为筛选按钮添加点击事件
        categoryBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const selectedCategory = this.dataset.category;
                updateUrl(selectedCategory);
                performFilter(selectedCategory);
            });
        });
    });
</script>

<style>
  .category-btn { color: #fff; }
  .category-btn:not(.active):hover { background-color: #6b6b6b; }
  .category-btn.active { color: #000; }
</style>